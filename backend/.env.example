APP_NAME=Universal Kiosk API
ENVIRONMENT=local
API_PREFIX=/api

# Session pooler for this project's IPv4 backend. Replace [YOUR-PASSWORD] locally.
DATABASE_URL=postgresql://postgres.amamatsmrevomzazpfcq:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://amamatsmrevomzazpfcq.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XA12dfhL7FWdSRovzkDivg_IALiThhQ
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=1440

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_DEV_AUTH_BYPASS=false
RATE_LIMIT_ENABLED=true
PAYMENT_EXPIRY_CRON_SECRET=replace-with-a-long-random-maintenance-secret
PAYMENT_EXPIRY_MINUTES=30
DEVICE_SESSION_DAYS=30
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

UPLOAD_ROOT=uploads

# Optional email delivery for signup OTP, welcome, reset-password, and staff-invite emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=PlaceURorder
SMTP_USE_TLS=true
DEV_EXPOSE_RESET_LINKS=false
EMAIL_OUTBOX_DIR=email_outbox

# Optional Redis cache for public kiosk menu reads.
REDIS_URL=
REDIS_MENU_TTL_SECONDS=120

# Backend-only payment provider settings. Never expose these through NEXT_PUBLIC_*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/admin/payments?provider=stripe&status=refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/admin/payments?provider=stripe&status=returned
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE_NAME=DEFAULT
PAYTM_DYNAMIC_QR_CREATE_URL=
PAYTM_TRANSACTION_STATUS_URL=
PAYTM_WEBHOOK_SECRET=

# Optional Pexels image search for owner/admin product and banner image picking.
# Put your real key in backend/.env or backend/.env.local, never in this example file.
PEXELS_API_KEY=your-pexels-api-key
PEXELS_PER_PAGE=12
